FROM node:20-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm i -g pnpm@12.6.0
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @magobox/database db:generate \
 && pnpm --filter @magobox/database build \
 && pnpm --filter @magobox/types build \
 && pnpm --filter @magobox/api build
ENV NODE_ENV=production
CMD ["sh", "-c", "cd packages/database && npx prisma db push --skip-generate && cd ../../apps/api && node dist/main"]
