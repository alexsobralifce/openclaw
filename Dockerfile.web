FROM node:20-slim
RUN npm i -g pnpm@12.6.0
WORKDIR /app

# Dependências antes do código: na e2-micro o `pnpm install` leva mais de 10 minutos.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/widget/package.json apps/widget/
COPY packages/database/package.json packages/database/
COPY packages/types/package.json packages/types/
# Rede da e2-micro é fraca: menos conexões simultâneas, mais paciência e repetição.
# O cache do BuildKit guarda os pacotes entre builds, então repetir sai barato.
ENV npm_config_fetch_retries=6 \
    npm_config_fetch_retry_maxtimeout=180000 \
    npm_config_fetch_timeout=300000 \
    npm_config_network_concurrency=3
RUN --mount=type=cache,target=/pnpm-store pnpm install --frozen-lockfile --store-dir /pnpm-store

COPY . .
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# Endereço público do site: usado na imagem de compartilhamento (Open Graph)
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
RUN pnpm --filter @openclaw/types build && pnpm --filter @openclaw/web build
ENV NODE_ENV=production
CMD ["sh", "-c", "cd apps/web && npx next start -p ${PORT:-3000}"]
