generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── MULTI-TENANCY ───────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         WorkspaceMember[]
  contacts      Contact[]
  conversations Conversation[]
  channels      Channel[]
  automations   Automation[]
  tags          Tag[]
  apiKeys       ApiKey[]
  webhooks      WebhookEndpoint[]
  memories      Memory[]
  documents     Document[]
}

enum Plan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

// ─── USUÁRIOS ────────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  phone        String? // WhatsApp (só dígitos, com DDI) usado para falar com o assistente
  // Nível na plataforma. ROOT/ADMIN aprovam cadastros e liberam serviços, sem ver o conteúdo dos workspaces.
  role         PlatformRole @default(USER)
  // ACTIVE por padrão para que contas já existentes continuem entrando; o cadastro público cria como PENDING
  status       UserStatus   @default(ACTIVE)
  services     String[]     @default([])
  // Plano comercial (aprendiz, mago, arquimago, teste); nulo = sem plano (valem os limites gerais do ambiente). Sem @unique de propósito.
  plan         String?
  // Canal principal do assistente: whatsapp (padrão) | app | telegram. Sem @unique: a unicidade do Telegram é garantida no código.
  assistantChannel String?
  telegramChatId   String?
  approvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workspaces    WorkspaceMember[]
  messages      Message[]
  conversations ConversationAssignee[]

  // Unicidade do telefone é garantida no código (users.service / auth.service): um índice único
  // numa coluna nova faz o `prisma db push` de produção parar pedindo --accept-data-loss
  @@index([phone])
  @@index([telegramChatId])
}

model WorkspaceMember {
  id        String        @id @default(cuid())
  role      WorkspaceRole @default(AGENT)
  createdAt DateTime      @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@unique([workspaceId, userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  AGENT
}

enum PlatformRole {
  ROOT
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

// ─── CRM ─────────────────────────────────────────────────────────

model Contact {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String?
  avatarUrl  String?
  externalId String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  conversations Conversation[]
  tags          ContactTag[]

  @@unique([workspaceId, phone])
  @@unique([workspaceId, email])
  // Instagram: o contato é identificado pelo IGSID (sem telefone). Índice comum, sem @unique, por causa do db push em produção
  @@index([workspaceId, externalId])
}

model Tag {
  id    String @id @default(cuid())
  name  String
  color String @default("#6366f1")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  contacts ContactTag[]

  @@unique([workspaceId, name])
}

model ContactTag {
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String

  @@id([contactId, tagId])
}

// ─── INBOX / CONVERSAS ───────────────────────────────────────────

model Conversation {
  id        String             @id @default(cuid())
  status    ConversationStatus @default(OPEN)
  subject   String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  contact     Contact   @relation(fields: [contactId], references: [id])
  contactId   String
  channel     Channel   @relation(fields: [channelId], references: [id])
  channelId   String

  messages  Message[]
  assignees ConversationAssignee[]
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SNOOZED
}

model ConversationAssignee {
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  @@id([conversationId, userId])
}

model Message {
  id         String      @id @default(cuid())
  body       String
  type       MessageType @default(TEXT)
  direction  Direction
  externalId String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  author         User?        @relation(fields: [authorId], references: [id])
  authorId       String?

  @@index([externalId])
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  FILE
  TEMPLATE
  ACTIVITY
}

enum Direction {
  INBOUND
  OUTBOUND
}

// ─── CANAIS ──────────────────────────────────────────────────────

model Channel {
  id        String      @id @default(cuid())
  name      String
  type      ChannelType
  config    Json
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  conversations Conversation[]
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  EMAIL
  WEBCHAT
}

// ─── AUTOMAÇÕES ──────────────────────────────────────────────────

model Automation {
  id        String    @id @default(cuid())
  name      String
  trigger   Json
  actions   Json
  isActive  Boolean   @default(true)
  runCount  Int       @default(0)
  lastRunAt DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@index([workspaceId, isActive])
}

// ─── FILA DE ENTRADA (webhooks do Evolution) ─────────────────────

model InboundEvent {
  id            String   @id @default(cuid())
  instance      String
  externalId    String
  payload       Json
  status        String   @default("PENDING") // PENDING | DONE | FAILED
  attempts      Int      @default(0)
  lastError     String?
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([instance, externalId])
  @@index([status, nextAttemptAt])
}

// ─── ESTADO COMPARTILHADO (chave-valor com expiração) ────────────

model KvEntry {
  key       String    @id
  value     Json
  expiresAt DateTime?

  @@index([expiresAt])
}

// ─── API KEYS ─────────────────────────────────────────────────────

model ApiKey {
  id        String    @id @default(cuid())
  name      String
  keyHash   String    @unique
  prefix    String    @default("")
  scopes    String[]  @default([])
  rateLimit Int       @default(60)
  expiresAt DateTime?
  revokedAt DateTime?
  lastUsed  DateTime?
  createdAt DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
}

// ─── WEBHOOKS DE SAÍDA ───────────────────────────────────────────

model WebhookEndpoint {
  id           String   @id @default(cuid())
  url          String
  secret       String // cifrado em repouso (AES-256-GCM)
  events       String[]
  isActive     Boolean  @default(true)
  failureCount Int      @default(0)
  createdAt    DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id            String   @id @default(cuid())
  eventId       String
  type          String
  payload       Json
  status        String   @default("PENDING") // PENDING | SUCCESS | FAILED
  attempts      Int      @default(0)
  responseCode  Int?
  lastError     String?
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())

  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId String

  @@index([status, nextAttemptAt])
}

// ─── IDEMPOTÊNCIA (API PÚBLICA) ──────────────────────────────────

model IdempotencyKey {
  id          String   @id @default(cuid())
  apiKeyId    String
  key         String
  requestHash String
  status      String   @default("IN_PROGRESS") // IN_PROGRESS | DONE
  response    Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([apiKeyId, key])
  @@index([expiresAt])
}

// ─── MEMÓRIA DO ASSISTENTE ───────────────────────────────────────

model Memory {
  id        String   @id @default(cuid())
  content   String
  kind      String   @default("fact")
  createdAt DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@index([workspaceId, createdAt])
}

// ─── COFRE DE SENHAS ─────────────────────────────────────────────
// Tudo que é sensível fica cifrado (AES-256-GCM). A chave do cofre é guardada cifrada pela senha mestra do usuário,
// que nunca é gravada. Os blocos formam uma cadeia de hashes com chave para detectar adulteração.
// Sem @unique de propósito (ver nota do db push em produção): o serviço garante uma linha por usuário.

model Vault {
  id          String   @id
  userId      String
  workspaceId String
  kdf         Json
  wrappedKey  String
  // Segundo cadeado da mesma chave, aberto pela chave de recuperação do dono (vazio se ainda não existir)
  recoverySalt    String @default("")
  recoveryWrapped String @default("")
  // Consulta pelo WhatsApp com código de 4 dígitos: chave própria (waKey), guardada de dois jeitos — cifrada pelo código
  // somado a um segredo do servidor (waKeyPin) e cifrada pela chave do cofre (waKeyMaster, para o painel criar cópias)
  waSalt      String @default("")
  waKeyPin    String @default("")
  waKeyMaster String @default("")
  seq         Int      @default(0)
  headHash    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model VaultBlock {
  id          String   @id @default(cuid())
  vaultId     String
  seq         Int
  prevHash    String
  op          String
  entryId     String
  payload     String   @default("")
  payloadHash String
  // Cópia da entrada cifrada com a chave do WhatsApp (fora da cadeia: é derivada; vazia se a entrada não é consultável por lá)
  waPayload   String   @default("")
  // Só o título, cifrado com segredo do servidor (sem o código): permite listar as senhas do WhatsApp antes de pedir o código
  waLabel     String   @default("")
  hash        String
  createdAt   DateTime @default(now())

  @@index([vaultId, seq])
  @@index([vaultId, entryId])
}

// ─── CONSUMO DE IA ────────────────────────────────────────────────
// Um contador por usuário, dia, provedor e modelo (incrementado de forma atômica). Tabela nova: a chave composta é o @@id,
// então não depende de @unique em coluna nova. userId "sistema" = chamadas sem usuário (rotinas automáticas).

model AiUsage {
  userId       String
  workspaceId  String
  day          String // AAAA-MM-DD no fuso do assistente
  provider     String // openai | gemini | whisper
  model        String
  calls        Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@id([userId, day, provider, model])
  @@index([day])
  @@index([workspaceId, day])
}

// ─── CANAL DO APP (chat do assistente dentro do MagoBox) ──────────

// Mensagens do chat do app, cifradas em repouso (AES-256-GCM, chave derivada do workspace). Não é "ponta a ponta":
// o servidor lê o texto para o assistente responder. IN = usuário → assistente; OUT = assistente → usuário.
model AppMessage {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  direction   String // IN | OUT
  kind        String // TEXT | AUDIO | FILE | IMAGE
  body        String // cifrado
  meta        Json? // { fileId, fileName, mime, size, seconds }
  // Mensagens com segredo (senha do cofre) somem sozinhas depois deste instante
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Assinatura de notificações do navegador (Web Push) de um usuário
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── CATÁLOGO DE DOCUMENTOS (PDFs com tags) ──────────────────────

// Ficha de cada documento que o dono guardou pelo assistente. O arquivo fica no Drive dele (Assist.IA/Documentos); aqui ficam título,
// assunto, tags e resumo para buscar e filtrar. `kind`: pdf (arquivo guardado) ou nota (nota antiga reclassificada, sem PDF original).
// Sem @unique de propósito (o `db push` de produção trava com índice único em coluna nova): a unicidade de (workspaceId, driveFileId) é do código.
model Document {
  id          String   @id @default(cuid())
  kind        String   @default("pdf")
  title       String
  topic       String
  // minúsculas, sem acento, com hífen no lugar de espaço (ex.: plano-de-saude)
  tags        String[] @default([])
  summary     String   @default("")
  driveFileId String
  account     String
  mime        String   @default("application/pdf")
  sizeBytes   Int      @default(0)
  pages       Int?
  // whatsapp | app | telegram | reclassificada
  origin      String   @default("whatsapp")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@index([workspaceId, createdAt])
  @@index([workspaceId, driveFileId])
}
