# Copie para apps/api/.env (a API lê o .env do diretório em que roda).
# Para o Prisma CLI, exporte também DATABASE_URL no shell (veja o README).

# ─── Banco de dados ────────────────────────────────────────
DATABASE_URL="postgresql://openclaw:openclaw@localhost:5433/openclaw"

# ─── Auth e segredos ───────────────────────────────────────
# Obrigatórios em produção (a API não sobe sem eles). JWT_SECRET com 24+ caracteres.
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
# Valida o webhook do Evolution E é a chave que cifra segredos de webhooks e tokens do Google.
# Depois de definido, NÃO troque: o que foi cifrado com ele deixa de ser legível.
WEBHOOK_SECRET="troque-por-outro-segredo-forte"

# ─── URLs ──────────────────────────────────────────────────
WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001"
PORT=3001

# ─── Evolution API (WhatsApp) ──────────────────────────────
EVOLUTION_API_URL="http://localhost:8082"
EVOLUTION_API_KEY="openclaw-evolution-key"

# ─── IA do assistente ──────────────────────────────────────
# Comandos livres, resumos e rascunhos. Sem a chave, só o menu por números funciona.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Transcrição de áudio e voz (opcional). Sem ela, a transcrição cai no Whisper (OPENAI_API_KEY).
GEMINI_API_KEY=""

# ─── Google (Gmail e Agenda) ───────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/integrations/google/callback"

# ─── Usuários e assistente ─────────────────────────────────
# E-mail de quem vira ROOT numa instalação existente (padrão: o usuário mais antigo)
ROOT_EMAIL=""
# Legado: número do dono antigo; na primeira subida é copiado para o cadastro do root
OWNER_WHATSAPP_NUMBER=""
# Opcional: instância de WhatsApp que TODOS os usuários podem usar como assistente.
# Atenção: o conteúdo (e-mails, agenda) passa pelo WhatsApp dessa instância.
# Vazio = cada usuário só comanda o assistente pelo WhatsApp conectado no próprio workspace.
ASSISTANT_SHARED_INSTANCE=""
ASSISTANT_TZ="America/Fortaleza"
# Horas sem uso até o modo carro/direção desligar sozinho
CAR_MODE_HOURS=3
# Teto de cadastros aguardando aprovação
MAX_PENDING_SIGNUPS=30
# Ao aprovar usuário acima deste número de ativos, a API lembra do backup (docs/operacao.md)
BACKUP_USERS_THRESHOLD=5

# ─── Ainda não usados pelo código (reservados para canais/cobrança futuros) ───
REDIS_URL="redis://localhost:6380"
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
RESEND_API_KEY=""
EMAIL_FROM="atendimento@seudominio.com"
ANTHROPIC_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
