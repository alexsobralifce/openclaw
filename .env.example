# ─── Banco de dados ────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/openclaw"

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET="troque-por-um-segredo-forte-em-producao"

# ─── URLs ──────────────────────────────────────────────────
WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# ─── Usuários e assistente ─────────────────────────────────
# E-mail de quem vira ROOT numa instalação existente (padrão: o usuário mais antigo)
ROOT_EMAIL=""
# Legado: número do dono antigo; na primeira subida é copiado para o cadastro do root
OWNER_WHATSAPP_NUMBER=""
# Opcional: instância de WhatsApp que TODOS os usuários podem usar como assistente.
# Atenção: o conteúdo (e-mails, agenda) passa pelo WhatsApp dessa instância.
# Vazio = cada usuário só comanda o assistente pelo WhatsApp conectado no próprio workspace.
ASSISTANT_SHARED_INSTANCE=""
ASSISTANT_TZ="America/Fortaleza"
# Horas sem uso até o modo carro/direção desligar sozinho
CAR_MODE_HOURS=3

# ─── Evolution API (WhatsApp) ──────────────────────────────
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="sua-chave-evolution"

# ─── Meta (Instagram / Facebook) ──────────────────────────
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="atendimento@seudominio.com"

# ─── AI (Claude) ───────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── Billing (Stripe) ──────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
