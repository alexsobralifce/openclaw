    "prints:onboarding": "node scripts/onboarding-prints/capture.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.6.0"
}
