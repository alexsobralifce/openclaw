{
  "name": "openclaw",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "test": "cd apps/api && pnpm test:layers",
    "smoke": "node scripts/smoke.mjs",
    "test:changed": "cd apps/api && pnpm test:changed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.6.0"
}
